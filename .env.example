# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored — never commit real keys.
# ---------------------------------------------------------------------------

# Resend API key — required for the /api/contact endpoint to send email.
# Get one free at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The "From" address on contact-form emails.
# Must be on a domain you have verified in Resend (https://resend.com/domains).
# Before your domain is verified, use: onboarding@resend.dev
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Where contact-form submissions get delivered.
CONTACT_TO_EMAIL=paudelsudip93@gmail.com

# Public canonical site URL — used for OG tags, sitemap.xml and robots.txt.
# Local: http://localhost:3000 | Production: https://sudippaudel.com
NEXT_PUBLIC_SITE_URL=https://sudippaudel.com
